{
  "$schema": "https://design-tokens.org/schema.json",
  "primitive": {
    "color": {
      "neutral": {
        "50": { "$value": "#FFFFFF", "$type": "color" },
        "100": { "$value": "#F5F2FF", "$type": "color" },
        "300": { "$value": "#C4BBDD", "$type": "color" },
        "400": { "$value": "#9A8FB8", "$type": "color" },
        "500": { "$value": "#6F63A3", "$type": "color" },
        "700": { "$value": "#2E2846", "$type": "color" },
        "800": { "$value": "#1E1A30", "$type": "color" },
        "900": { "$value": "#151224", "$type": "color" },
        "950": { "$value": "#0B0912", "$type": "color" }
      },
      "ember": {
        "300": { "$value": "#FF8A8F", "$type": "color" },
        "500": { "$value": "#F0555F", "$type": "color" },
        "600": { "$value": "#E24852", "$type": "color" },
        "900": { "$value": "#3D1622", "$type": "color" },
        "950": { "$value": "#1A0507", "$type": "color" }
      },
      "gold": {
        "500": { "$value": "#F2B33D", "$type": "color" },
        "950": { "$value": "#1E1403", "$type": "color" }
      },
      "live": {
        "500": { "$value": "#3DDCE8", "$type": "color" },
        "950": { "$value": "#02171A", "$type": "color" }
      },
      "magenta": {
        "500": { "$value": "#E86FD6", "$type": "color" },
        "950": { "$value": "#1E0320", "$type": "color" }
      },
      "status": {
        "success": { "$value": "#46D18A", "$type": "color" },
        "danger": { "$value": "#FF6B6B", "$type": "color" },
        "warning": { "$value": "#F5B14C", "$type": "color" }
      }
    },
    "spacing": {
      "0": { "$value": "0", "$type": "dimension" },
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" }
    },
    "radius": {
      "sm": { "$value": "6px", "$type": "dimension" },
      "md": { "$value": "10px", "$type": "dimension" },
      "lg": { "$value": "16px", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "fontSize": {
      "caption": { "$value": "0.75rem", "$type": "dimension" },
      "body-sm": { "$value": "0.875rem", "$type": "dimension" },
      "body": { "$value": "1rem", "$type": "dimension" },
      "lead": { "$value": "1.125rem", "$type": "dimension" },
      "title": { "$value": "1.25rem", "$type": "dimension" },
      "display": { "$value": "1.75rem", "$type": "dimension" }
    },
    "lineHeight": {
      "caption": { "$value": "1.4", "$type": "number" },
      "body-sm": { "$value": "1.5", "$type": "number" },
      "body": { "$value": "1.6", "$type": "number" },
      "lead": { "$value": "1.45", "$type": "number" },
      "title": { "$value": "1.3", "$type": "number" },
      "display": { "$value": "1.2", "$type": "number" }
    },
    "fontFamily": {
      "display": {
        "$value": "ui-rounded, 'SF Pro Rounded', 'Segoe UI Variable Display', system-ui, sans-serif",
        "$type": "fontFamily"
      },
      "body": {
        "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', 'Noto Sans', Arial, sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace",
        "$type": "fontFamily"
      }
    },
    "duration": {
      "instant": { "$value": "90ms", "$type": "duration" },
      "quick": { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "220ms", "$type": "duration" },
      "slow": { "$value": "380ms", "$type": "duration" }
    },
    "easing": {
      "out": { "$value": "ease-out", "$type": "other" },
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "other" }
    }
  },
  "semantic": {
    "color": {
      "bg": { "$value": "{primitive.color.neutral.950}", "$type": "color" },
      "surface": { "$value": "{primitive.color.neutral.900}", "$type": "color" },
      "surface-raised": { "$value": "{primitive.color.neutral.800}", "$type": "color" },
      "border": { "$value": "{primitive.color.neutral.700}", "$type": "color" },
      "border-control": { "$value": "{primitive.color.neutral.500}", "$type": "color" },
      "fg": { "$value": "{primitive.color.neutral.100}", "$type": "color" },
      "fg-muted": { "$value": "{primitive.color.neutral.300}", "$type": "color" },
      "fg-subtle": { "$value": "{primitive.color.neutral.400}", "$type": "color" },
      "ember": { "$value": "{primitive.color.ember.500}", "$type": "color" },
      "ember-hover": { "$value": "{primitive.color.ember.300}", "$type": "color" },
      "ember-active": { "$value": "{primitive.color.ember.600}", "$type": "color" },
      "on-ember": { "$value": "{primitive.color.ember.950}", "$type": "color" },
      "bubble-user": { "$value": "{primitive.color.ember.900}", "$type": "color" },
      "gold": { "$value": "{primitive.color.gold.500}", "$type": "color" },
      "on-gold": { "$value": "{primitive.color.gold.950}", "$type": "color" },
      "live": { "$value": "{primitive.color.live.500}", "$type": "color" },
      "on-live": { "$value": "{primitive.color.live.950}", "$type": "color" },
      "magenta": { "$value": "{primitive.color.magenta.500}", "$type": "color" },
      "on-magenta": { "$value": "{primitive.color.magenta.950}", "$type": "color" },
      "success": { "$value": "{primitive.color.status.success}", "$type": "color" },
      "danger": { "$value": "{primitive.color.status.danger}", "$type": "color" },
      "warning": { "$value": "{primitive.color.status.warning}", "$type": "color" }
    },
    "spacing": {
      "gutter": { "$value": "{primitive.spacing.4}", "$type": "dimension" },
      "stack": { "$value": "{primitive.spacing.3}", "$type": "dimension" },
      "inline": { "$value": "{primitive.spacing.2}", "$type": "dimension" }
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": { "$value": "{semantic.color.ember}", "$type": "color" },
        "fg": { "$value": "{semantic.color.on-ember}", "$type": "color" },
        "hover-bg": { "$value": "{semantic.color.ember-hover}", "$type": "color" },
        "active-bg": { "$value": "{semantic.color.ember-active}", "$type": "color" },
        "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" },
        "padding-x": { "$value": "{primitive.spacing.4}", "$type": "dimension" },
        "padding-y": { "$value": "{primitive.spacing.2}", "$type": "dimension" }
      },
      "secondary": {
        "bg": { "$value": "transparent", "$type": "color" },
        "border": { "$value": "{semantic.color.border-control}", "$type": "color" },
        "fg": { "$value": "{semantic.color.fg}", "$type": "color" },
        "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" },
        "padding-x": { "$value": "{primitive.spacing.4}", "$type": "dimension" },
        "padding-y": { "$value": "{primitive.spacing.2}", "$type": "dimension" }
      }
    },
    "input": {
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.border-control}", "$type": "color" },
      "fg": { "$value": "{semantic.color.fg}", "$type": "color" },
      "placeholder": { "$value": "{semantic.color.fg-subtle}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.sm}", "$type": "dimension" }
    },
    "bubble": {
      "humi": {
        "bg": { "$value": "{semantic.color.surface-raised}", "$type": "color" },
        "fg": { "$value": "{semantic.color.fg}", "$type": "color" },
        "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" }
      },
      "user": {
        "bg": { "$value": "{semantic.color.bubble-user}", "$type": "color" },
        "fg": { "$value": "{semantic.color.fg}", "$type": "color" },
        "border": { "$value": "{semantic.color.border}", "$type": "color" },
        "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" }
      },
      "system": {
        "fg": { "$value": "{semantic.color.fg-subtle}", "$type": "color" }
      }
    },
    "panel": {
      "avatar": {
        "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
        "radius": { "$value": "{primitive.radius.lg}", "$type": "dimension" },
        "ring-idle": { "$value": "{semantic.color.border}", "$type": "color" },
        "ring-live": { "$value": "{semantic.color.live}", "$type": "color" }
      }
    },
    "badge": {
      "live": {
        "bg": { "$value": "{semantic.color.live}", "$type": "color" },
        "fg": { "$value": "{semantic.color.on-live}", "$type": "color" }
      },
      "gold": {
        "bg": { "$value": "{semantic.color.gold}", "$type": "color" },
        "fg": { "$value": "{semantic.color.on-gold}", "$type": "color" }
      },
      "emotion": {
        "bg": { "$value": "{semantic.color.magenta}", "$type": "color" },
        "fg": { "$value": "{semantic.color.on-magenta}", "$type": "color" }
      }
    },
    "status": {
      "dot": {
        "connected": { "$value": "{semantic.color.success}", "$type": "color" },
        "disconnected": { "$value": "{semantic.color.danger}", "$type": "color" }
      },
      "focus-ring": { "$value": "{semantic.color.ember}", "$type": "color" }
    }
  }
}