root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{js,ts,tsx,jsx,json,yaml,yml,html,css}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.toml]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
