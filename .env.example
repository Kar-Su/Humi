# Salin jadi .env lalu sesuaikan. Jangan pernah commit .env.

COMPOSE_PROJECT_NAME=humi

# Port yang diekspos ke host
FRONTEND_PORT=5173
GATEWAY_PORT=8080
OLLAMA_PORT=11434

# LLM - provider: ollama | groq | openrouter | auto (fallback chain)
LLM_PROVIDER=ollama
# kosongkan = pakai default provider (ollama: qwen3:4b, groq: llama-3.3-70b-versatile, openrouter: qwen/qwen3-32b:free)
LLM_MODEL=
# isi jika pakai groq/openrouter
GROQ_API_KEY=
OPENROUTER_API_KEY=
FISH_API_KEY=
FISH_API_BASE=https://api.fish.audio
FISH_REFERENCE_ID=b8357529925148c3909f583caf29c33c
FISH_MODEL=

# Model
OLLAMA_MODEL=qwen3:4b
# fallback lokal saat auto (jika groq/openrouter 429/offline)
LLM_FALLBACK=ollama
WHISPER_MODEL=small
TTS_ENGINE=espeech

# Prod config
DOMAIN=localhost
CLOUDFLARE_TOKEN=YOUR-TOKEN
